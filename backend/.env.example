# ─────────────────────────────────────────────────────────────────────────────
# HelioVision – Environment Variables Reference
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit your actual .env to version control.
#
# Minimum required for production (Render):
#   SECRET_KEY, ALLOWED_ORIGINS_STR, model paths, ENVIRONMENT=production
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="HelioVision Solar AI Platform"
APP_VERSION="1.0.0"
ENVIRONMENT=production              # development | staging | production
DEBUG=false

# ── API Security ──────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET_KEY

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS_STR=https://your-app.vercel.app,http://localhost:3000

# ── ML Model Paths ────────────────────────────────────────────────────────────
# On Render: models are bundled in the Docker image at /models/
SOLAR_FORECAST_MODEL_PATH=/models/solar_forecast_model.pkl
SAVINGS_MODEL_PATH=/models/savings_prediction_model.pkl
YOLO_MODEL_PATH=/models/prediction_yolo1.pt

# ── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json                    # json (production) | text (dev)
LOG_FILE=logs/solar_api.log

# ── Database (FULLY OPTIONAL) ─────────────────────────────────────────────────
# Leave DATABASE_URL empty to run without any database (recommended for Render).
# Core AI: roof detection, solar forecast, savings — all work without a DB.
# Only needed if you want to enable prediction analytics logging in the future.
#
# SQLite (local dev):   sqlite+aiosqlite:///solar_db.sqlite
# PostgreSQL (prod):    postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=

# ── Redis (FULLY OPTIONAL) ────────────────────────────────────────────────────
# Leave REDIS_URL empty to use in-memory rate limiting (default, no Redis needed).
# Only needed for distributed/multi-instance rate limiting.
# redis://localhost:6379/0
REDIS_URL=

# ── External Services (optional) ──────────────────────────────────────────────
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5
